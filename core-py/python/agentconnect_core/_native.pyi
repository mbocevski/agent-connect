    ) -> dict[str, Any]: ...
    def discard_pending_commit(self, group_id: bytes) -> None: ...
    def delete_group(self, group_id: bytes) -> None: ...
    def create_knock(
        self,
        door_id: bytes,
        door_key: bytes,
        display_name: str,
        note: str | None = None,
        *,
        ts: int | None = None,
    ) -> tuple[bytes, PendingKnock]: ...
    def verify_knock(self, opened: OpenedKnock) -> VerifiedKnock: ...
    def restore_knock(self, data: bytes) -> VerifiedKnock: ...
    def add_knock(self, group_id: bytes, knock: VerifiedKnock, now: int) -> dict[str, Any]: ...
    def join_knock(
        self,
        pending: PendingKnock,
        identity: str,
        name: str,
        wrapped_welcome: bytes,
        key: str | None = None,
        context: bytes | None = None,
    ) -> bytes: ...
    def generate_door(self, expires_at: int) -> Door: ...
    def _mark_key_package_used_for_testing(self, kp_ref: bytes) -> None: ...
    def forget_knock(self, pending: PendingKnock) -> None: ...
    def delete_key_package(self, key_package: bytes) -> None: ...

