import builtins
from typing import Any, final, override

PROTOCOL_VERSION: int
CIPHERSUITE_V0: str
PADDING_BUCKETS: list[int]
DB_KEY_LEN: int

class AgentConnectError(ValueError): ...
class CoreError(Exception): ...

@final
class Identity:
    @staticmethod
    def generate() -> Identity: ...
    @staticmethod
    def _generate_for_testing(seed: int) -> Identity: ...
    @staticmethod
    def from_secret_bytes(secret: bytes) -> Identity: ...
    def secret_bytes(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    @property
    def id(self) -> str: ...
    @property
    def fingerprint(self) -> str: ...
    def create_instance(self) -> Instance: ...
    def _create_instance_for_testing(
        self, seed: int | None = None, now: int | None = None
    ) -> Instance: ...

@final
class Instance:
    @staticmethod
    def from_secret_bytes(data: bytes) -> Instance: ...
    def to_secret_bytes(self) -> bytes: ...
    @property
    def identity(self) -> str: ...
    @property
    def instance_id(self) -> int: ...
    @property
    def instance_id_hex(self) -> str: ...
    @property
    def mailbox_id(self) -> str: ...
    @property
    def public_key(self) -> bytes: ...
    @property
    def cert_json(self) -> bytes: ...
    def sign_relay_challenge(self, nonce: bytes, relay_host: str) -> bytes: ...
    def sign_relay_request(
        self, method: str, path: str, ts: int, body: bytes, relay_host: str
    ) -> bytes: ...

@final
class Invite:
    @staticmethod
    def from_parts(relay_host: str, invite_id: bytes, secret: bytes, expires_at: int) -> Invite: ...
    @property
    def url(self) -> str: ...
    @property
    def relay_host(self) -> str: ...
    @property
    def invite_id(self) -> bytes: ...
    @property
    def invite_id_b64(self) -> str: ...
    @property
    def expires_at(self) -> int: ...
    def secret_bytes(self) -> bytes: ...

@final
class InviteLink:
    @property
    def url(self) -> str: ...
    @property
    def relay_host(self) -> str: ...
    @property
    def invite_id(self) -> bytes: ...
    @property
    def invite_id_b64(self) -> str: ...
    def secret_bytes(self) -> bytes: ...

@final
class Sas:
    @property
    def bytes(self) -> builtins.bytes: ...
    @property
    def emoji_indices(self) -> list[int]: ...
    @property
    def decimal(self) -> str: ...
    @override
    def __eq__(self, other: object) -> bool: ...
    @override
    def __hash__(self) -> int: ...

@final
class VerifiedJoinRequest:
    @property
    def identity(self) -> str: ...
    @property
    def instance_id(self) -> int: ...
    @property
    def display_name(self) -> str: ...
    @property
    def mailbox_id(self) -> str: ...

@final
class Client:
    def __init__(self, path: str | None, instance: bytes, db_key: bytes | None = None) -> None: ...
    @staticmethod
    def _for_testing(
        path: str | None, instance: bytes, seed: int, db_key: bytes | None = None
    ) -> Client: ...
    def _set_time_for_testing(self, now: int | None) -> None: ...
    def _panic_for_testing(self) -> None: ...
    @property
    def identity(self) -> str: ...
    @property
    def mailbox_id(self) -> str: ...
    @property
    def instance_id_hex(self) -> str: ...
    def create_group(self, name: str, purpose: str) -> bytes: ...
    def create_invite(self, relay_host: str, ttl_secs: int = 86400) -> Invite: ...
    def create_join_request(self, link: InviteLink, display_name: str) -> bytes: ...
    def verify_join_request(self, request: bytes, invite: Invite) -> VerifiedJoinRequest: ...
    def add_member(
        self,
        group_id: bytes,
        request: VerifiedJoinRequest,
        invite: Invite,
        switch_floor: bool = True,
    ) -> dict[str, Any]: ...
    def join(self, link: InviteLink, invite_meta: bytes, wrapped_welcome: bytes) -> bytes: ...
    def process(self, group_id: bytes, message: bytes) -> dict[str, Any]: ...
    def seal(self, group_id: bytes, inner: bytes) -> bytes: ...
    def open(self, group_id: bytes, ciphertext: bytes) -> dict[str, Any]: ...
    def sas(self, group_id: bytes) -> Sas: ...
    def epoch(self, group_id: bytes) -> int: ...
    def members(self, group_id: bytes) -> list[dict[str, Any]]: ...
    def policy(self, group_id: bytes) -> bytes: ...
    def meta(self, group_id: bytes) -> bytes: ...
    def has_pending_commit(self, group_id: bytes) -> bool: ...
    def remove(self, group_id: bytes, identity: str) -> dict[str, Any]: ...
    def update(self, group_id: bytes) -> dict[str, Any]: ...
    def set_policy(self, group_id: bytes, policy: bytes) -> dict[str, Any]: ...
    def commit_pending_proposals(self, group_id: bytes) -> dict[str, Any]: ...
    def propose_leave(self, group_id: bytes) -> bytes: ...
    def confirm_pending_commit(self, group_id: bytes, msg_id: str) -> dict[str, Any]: ...
    def discard_pending_commit(self, group_id: bytes) -> None: ...
    def delete_group(self, group_id: bytes) -> None: ...

def supports_protocol(v: int) -> bool: ...
def parse_invite_url(url: str) -> InviteLink: ...
def join_request_mac(
    invite_id: bytes, secret: bytes, key_package: bytes, mailbox_id: str, display_name: str
) -> bytes: ...
def unwrap_welcome(invite_id: bytes, secret: bytes, wrapped: bytes) -> bytes: ...
def derive_sas(epoch_authenticator: bytes, group_id: bytes, epoch: int) -> Sas: ...
def padding_bucket(plaintext_len: int) -> int | None: ...
def rekey_store(path: str, old_key: bytes, new_key: bytes) -> None: ...
def verify_instance_cert(cert_json: bytes) -> dict[str, Any]: ...
def identity_id(ik_pub: bytes) -> str: ...
def fingerprint(ik_pub: bytes) -> str: ...
def mailbox_id(sig_key: bytes) -> str: ...
