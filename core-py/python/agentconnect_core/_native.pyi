    def update(self, group_id: bytes) -> dict[str, Any]: ...
    def set_policy(self, group_id: bytes, policy: bytes) -> dict[str, Any]: ...
    def commit_pending_proposals(self, group_id: bytes) -> dict[str, Any]: ...
